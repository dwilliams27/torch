+def _pose_field(hdr: dict) -> dict | None:
+    """Headers `view` and `proj` (16 finite numbers each, column-major 4x4: camera-to-world and
+    projection, as three.js) and the depth's `lo`/`hi` (its metric inverse-depth range) -> a pose
+    for an engine that reprojects (torch_turbo noise=anchor), or None."""
+    v, p, d = hdr.get("view"), hdr.get("proj"), hdr.get("depth")
+    num = lambda x: isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)
+    ok = lambda a: isinstance(a, list) and len(a) == 16 and all(num(x) for x in a)
+    if not (ok(v) and ok(p) and isinstance(d, dict)):
+        return None
+    lo, hi = d.get("lo"), d.get("hi")
+    if not (num(lo) and num(hi) and 0 < lo < hi):
+        return None
+    return {"view": np.asarray(v, np.float32).reshape(4, 4).T, "proj": np.asarray(p, np.float32).reshape(4, 4).T,
+            "lo": float(lo), "hi": float(hi)}
+
+
 def pack(header: dict, payload: bytes = b"") -> bytes:
