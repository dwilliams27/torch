+    def _anchored_noise(self, seed, base, held, pose, depth):
+        """The stream's noise, carried with the surfaces from its last new framing (noise=anchor)."""
+        key = (int(seed), tuple(base.shape))
+        st = self._stream_noise.pop(key, None)
+        n, h, w = base.shape[1], base.shape[2], base.shape[3]
+        if pose is None or depth is None or np.asarray(depth).shape != (h, w):
+            out = st[0] if st is not None and held else base
+        elif st is None or st[1] is None:
+            out = base
+        elif held:
+            out = st[0]
+        else:
+            d = np.asarray(depth, np.float32)
+            inv = pose["lo"] + (d + 1.0) * 0.5 * (pose["hi"] - pose["lo"])
+            g = reproject_grid(inv, pose["view"], pose["proj"], *st[1])[0]     # (h, w, 2) in [-1, 1]
+            ix = torch.round(((g[..., 0] + 1) * w - 1) / 2).long().flatten()
+            iy = torch.round(((g[..., 1] + 1) * h - 1) / 2).long().flatten()
+            src = torch.where((ix >= 0) & (ix < w) & (iy >= 0) & (iy < h), iy * w + ix, torch.full_like(ix, -1))
+            order = torch.argsort(src, stable=True)
+            ss = src[order]
+            first = torch.ones_like(ss, dtype=torch.bool)
+            first[1:] = ss[1:] != ss[:-1]
+            keep = torch.zeros_like(src, dtype=torch.bool)
+            keep[order[first & (ss >= 0)]] = True
+            gen = torch.Generator("cpu").manual_seed((int(seed) * 1000003 + self._frame) & 0x7FFFFFFFFFFFFFFF)
+            out = torch.randn(base.shape, generator=gen, dtype=torch.float32).to(base.device, base.dtype)
+            prev = st[0].reshape(base.shape[0], n, h * w)
+            flat = out.reshape(base.shape[0], n, h * w)
+            idx = torch.nonzero(keep).flatten().to(base.device)
+            flat[:, :, idx] = prev[:, :, src[keep].to(base.device)]
+            out = flat.reshape(base.shape)
+            self.last_noise_kept = float(keep.float().mean())
