+def reproject_grid(inv_depth, view_cur, proj_cur, view_old, proj_old) -> "torch.Tensor":
+    """A backward-warp grid for F.grid_sample on an earlier frame's features: for each pixel of
+    the current frame, where its surface point was in the earlier frame. inv_depth: (h, w) metric
+    inverse depth (1/m), rows top first; view_*: 4x4 camera-to-world, proj_*: 4x4 perspective
+    projections (column vectors, as three.js). Returns (1, h, w, 2) in [-1, 1], x right, y down."""
+    iz = torch.as_tensor(np.asarray(inv_depth, np.float32))
+    h, w = iz.shape
+    y_ndc = (1 - 2 * (torch.arange(h, dtype=torch.float32) + 0.5) / h)[:, None].expand(h, w)
+    x_ndc = (2 * (torch.arange(w, dtype=torch.float32) + 0.5) / w - 1)[None, :].expand(h, w)
+    z = 1.0 / iz.clamp(min=1e-4)
+    Pc, Po = (torch.as_tensor(np.asarray(m, np.float32)) for m in (proj_cur, proj_old))
+    pts = torch.stack([x_ndc * z / Pc[0, 0], y_ndc * z / Pc[1, 1], -z, torch.ones_like(z)], -1).reshape(-1, 4)
+    world = pts @ torch.as_tensor(np.asarray(view_cur, np.float32)).T
+    old = world @ torch.linalg.inv(torch.as_tensor(np.asarray(view_old, np.float32))).T
+    zo = (-old[:, 2]).clamp(min=1e-4)
+    return torch.stack([Po[0, 0] * old[:, 0] / zo, -(Po[1, 1] * old[:, 1] / zo)], -1).reshape(1, h, w, 2)
+
